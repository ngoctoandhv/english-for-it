# Copy to .env.production on the server. Keep it out of git (it is git-ignored). Replace every CHANGE_ME.
POSTGRES_USER=english_for_it
POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME_run_bin_rails_secret
ALLOWED_HOSTS=api.example.com
CORS_ORIGINS=https://app.example.com
API_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
RAILS_LOG_LEVEL=info
# S3-compatible audio storage (recommended in production)
STORAGE_SERVICE=s3
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=auto
S3_BUCKET=english-for-it-audio
S3_ENDPOINT=https://s3.example.com

# Email (password reset and verification). Any SMTP provider with a free tier works (Brevo, Resend, Mailjet).
WEB_URL=https://your-web-domain.example
MAIL_FROM="English for IT <no-reply@your-domain.example>"
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NEXT_PUBLIC_SITE_URL=https://your-web-domain.example
