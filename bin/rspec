#!/usr/bin/env bash
# Run RSpec in Docker (test env). Usage: bin/rspec [rspec args], e.g. bin/rspec spec/requests/auth_spec.rb
cd "$(dirname "$0")/.."
docker compose up -d db redis >/dev/null 2>&1
docker compose run --rm --no-deps -e RAILS_ENV=test -e DATABASE_URL=postgres://postgres:postgres@db:5432 -e REDIS_URL=redis://redis:6379/0 api \
  bash -c 'bin/rails db:prepare >/dev/null 2>&1; bundle exec rspec "$@"' _ "$@"
