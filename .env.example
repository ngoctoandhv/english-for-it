# Copy to .env (never commit .env). Values below are local-development defaults only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5433
API_PORT=3100
WEB_PORT=3101

# Rails
RAILS_ENV=development
CORS_ORIGINS=http://localhost:3101

# Web (read by Next.js; NEXT_PUBLIC_ values are visible in the browser)
NEXT_PUBLIC_API_URL=http://localhost:3100

# File storage: local disk by default; set STORAGE_SERVICE=s3 plus the S3_* values for S3-compatible storage
STORAGE_SERVICE=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
API_PUBLIC_URL=http://localhost:3100

# Auth attempts allowed per minute per IP (10 in production; raised locally so repeated E2E runs are not throttled)
AUTH_THROTTLE_LIMIT=100
API_THROTTLE_LIMIT=20000

# Public address of the web app (sitemap, social previews). Server-side calls to the API use API_INTERNAL_URL (set by compose).
NEXT_PUBLIC_SITE_URL=http://localhost:3101

# Web Push reminders (optional). Generate keys with: docker compose run --rm --no-deps api bin/rails push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the hourly reminder job (POST /api/v1/internal/reminders with header X-Cron-Secret). Unset = endpoint disabled.
CRON_SECRET=
# Error tracking (optional)
SENTRY_DSN=
